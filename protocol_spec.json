{
  "protocol_name": "TriviaTeam JSON Application Protocol",
  "author": "Darren Robinson",
  "transport": "HTTP/1.1 over TCP",
  "encoding": "UTF-8 JSON",
  "session": "Flask signed cookie (UUID, role, idx_of_trivia_set, question_idx)",
  "integrity_header": "X-Signature (HMAC-SHA256 hex of raw body)",
  "heartbeat": {
    "interval_seconds": 5,
    "timeout_seconds": 15,
    "ping": {
      "type": "PING",
      "timestamp": "unix_seconds"
    },
    "pong": {
      "type": "PONG",
      "timestamp": "unix_seconds"
    }
  },
  "messages": [
    {
      "name": "REGISTER_USER",
      "method": "POST",
      "path": "/api/users",
      "purpose": "Create a student or teacher account",
      "required_fields": [
        "username",
        "password"
      ],
      "optional_fields": [
        "role"
      ],
      "success": {
        "status": 201,
        "body": {
          "message": "new user created!",
          "signing_token": "<random per-session token, used to sign write-sensitive requests>"
        }
      },
      "error": [
        {
          "status": 400,
          "body": {
            "error": "missing required field(s): ..."
          }
        },
        {
          "status": 409,
          "body": "username already taken"
        }
      ],
      "note": "signing_token replaces the old design where every browser shared one static secret (TRIVIA_HMAC_SECRET) baked into Static/script.js. This token is fresh and random per session, returned once here (and again on LOGIN), and is what the client signs write-sensitive requests with -- see PROTOCOL.md Section 1."
    },
    {
      "name": "LOGIN",
      "method": "POST",
      "path": "/api/login",
      "purpose": "Authenticate and establish a session",
      "required_fields": [
        "username",
        "password"
      ],
      "success": {
        "status": 200,
        "body": {
          "role": "student|teacher",
          "signing_token": "<random per-session token, used to sign write-sensitive requests>"
        }
      },
      "error": {
        "status": 401,
        "body": {
          "error": "invalid username or password"
        }
      },
      "note": "Same signing_token mechanism as REGISTER_USER -- see its note above."
    },
    {
      "name": "CREATE_TRIVIA",
      "method": "POST",
      "path": "/api/trivia",
      "purpose": "Teacher uploads a quiz JSON array",
      "auth": [
        "teacher",
        "valid_signature"
      ],
      "required_fields": [
        "JSON array of question objects"
      ],
      "success": {
        "status": 200,
        "body": "trivia set index string"
      },
      "error": [
        {
          "status": 401,
          "body": {
            "error": "not authenticated"
          }
        },
        {
          "status": 403,
          "body": {
            "error": "forbidden: insufficient role"
          }
        },
        {
          "status": 400,
          "body": {
            "error": "invalid or missing payload signature"
          }
        }
      ]
    },
    {
      "name": "GET_QUESTION",
      "method": "GET",
      "path": "/api/trivia",
      "purpose": "Fetch current question without the answer key",
      "auth": [
        "login"
      ],
      "required_fields": [
        "session.idx_of_trivia_set",
        "session.question_idx"
      ],
      "success": {
        "status": 200,
        "body": {
          "type": "...",
          "question": "..."
        }
      },
      "error": {
        "status": 400,
        "body": "No active trivia set selected."
      }
    },
    {
      "name": "SUBMIT_ANSWER",
      "method": [
        "GET",
        "POST"
      ],
      "path": "/api/trivia/verify",
      "purpose": "Grade the student's answer for the current question",
      "auth": [
        "login",
        "valid_signature"
      ],
      "required_fields": [
        "answer"
      ],
      "success": {
        "status": 200,
        "body": {
          "correct": true
        }
      },
      "error": {
        "status": 400,
        "body": {
          "error": "invalid or missing payload signature"
        }
      },
      "note": "Both methods accepted. GET is the original protocol design (used by non-browser test clients); POST is required because browsers cannot send a request body on GET/HEAD, and the real frontend always sends POST. This route used to declare GET only, which meant the browser client's actual request 405'd and silently fell back to local-only grading -- fixed after being caught by integration testing (Deliverable 2 report, Section 7)."
    },
    {
      "name": "NEXT_QUESTION",
      "method": "GET",
      "path": "/api/trivia/next",
      "purpose": "Advance one question forward (never backward)",
      "auth": [
        "login"
      ],
      "success": {
        "status": 200,
        "body": "next question OR {done:true}"
      },
      "error": {
        "status": 400,
        "body": "No active trivia set selected."
      }
    },
    {
      "name": "GET_ANALYTICS",
      "method": [
        "GET",
        "POST"
      ],
      "path": "/api/trivia/analytics",
      "purpose": "Teacher views per-question stats",
      "auth": [
        "teacher"
      ],
      "required_fields": [
        "idx_of_trivia_set"
      ],
      "success": {
        "status": 200,
        "body": [
          {
            "correct": 0,
            "incorrect": 0,
            "responses": []
          }
        ]
      },
      "note": "Same GET-with-body issue as SUBMIT_ANSWER, same fix: this route now accepts both GET and POST since the frontend sends POST."
    },
    {
      "name": "HEARTBEAT",
      "method": "POST",
      "path": "/api/heartbeat",
      "purpose": "Client liveness check (PING/PONG)",
      "auth": [
        "login"
      ],
      "required_fields": [
        "type",
        "timestamp"
      ],
      "success": {
        "status": 200,
        "body": {
          "type": "PONG",
          "timestamp": 0
        }
      }
    },
    {
      "name": "RECONNECT",
      "method": "GET",
      "path": "/api/reconnect",
      "purpose": "Restore quiz progress after a dropped connection",
      "auth": [
        "login"
      ],
      "success": {
        "status": 200,
        "body": {
          "idx_of_trivia_set": 0,
          "question_idx": 0
        }
      },
      "error": {
        "status": 404,
        "body": {
          "error": "no saved progress for this session"
        }
      }
    },
    {
      "name": "CREATE_ROOM",
      "method": "POST",
      "path": "/api/rooms",
      "purpose": "Teacher opens a 4-digit PIN lobby for a trivia set",
      "auth": [
        "teacher"
      ],
      "required_fields": [
        "idx_of_trivia_set"
      ],
      "optional_fields": [
        "pacing_mode"
      ],
      "success": {
        "status": 201,
        "body": {
          "room_code": "4821",
          "status": "waiting"
        }
      },
      "error": {
        "status": 404,
        "body": {
          "error": "trivia set not found"
        }
      }
    },
    {
      "name": "JOIN_ROOM",
      "method": "POST",
      "path": "/api/rooms/join",
      "purpose": "Student joins a lobby by room PIN",
      "auth": [
        "login"
      ],
      "required_fields": [
        "room_code"
      ],
      "success": {
        "status": 200,
        "body": {
          "room_code": "4821",
          "player_count": 2
        }
      },
      "error": {
        "status": 404,
        "body": {
          "error": "room not found"
        }
      }
    },
    {
      "name": "GET_ROOM",
      "method": "GET",
      "path": "/api/rooms/<room_code>",
      "purpose": "Poll lobby roster and status",
      "auth": [
        "login"
      ],
      "success": {
        "status": 200,
        "body": {
          "status": "waiting|active",
          "players": []
        }
      }
    },
    {
      "name": "CHECK_CONNECTIVITY",
      "method": "GET",
      "path": "/api/rooms/<room_code>/connectivity",
      "purpose": "Timeout-detection reliability feature: reports which players in a room have sent a heartbeat PING within reliability.py's HEARTBEAT_TIMEOUT_SECONDS window",
      "auth": [
        "login"
      ],
      "success": {
        "status": 200,
        "body": {
          "room_code": "4821",
          "players": [
            {
              "UUID": "...",
              "username": "...",
              "connected": true
            }
          ]
        }
      },
      "error": {
        "status": 404,
        "body": {
          "error": "room not found"
        }
      }
    },
    {
      "name": "START_ROOM",
      "method": "POST",
      "path": "/api/rooms/<room_code>/start",
      "purpose": "Host starts the game (waiting -> active)",
      "auth": [
        "teacher"
      ],
      "success": {
        "status": 200,
        "body": {
          "status": "active"
        }
      }
    },
    {
      "name": "ADVANCE_ROOM",
      "method": "POST",
      "path": "/api/rooms/<room_code>/next",
      "purpose": "Host-paced dispatch: host advances the room's shared question index so every player sees the same question at the same time",
      "auth": [
        "teacher",
        "must be this room's host"
      ],
      "success": {
        "status": 200,
        "body": {
          "room_code": "4821",
          "question_idx": 1,
          "status": "active"
        }
      },
      "error": [
        {
          "status": 403,
          "body": {
            "error": "only the host can advance the room"
          }
        },
        {
          "status": 409,
          "body": {
            "error": "room is not active"
          }
        },
        {
          "status": 404,
          "body": {
            "error": "room not found"
          }
        }
      ]
    },
    {
      "name": "LEAVE_ROOM",
      "method": "POST",
      "path": "/api/rooms/leave",
      "purpose": "Leave the current lobby",
      "auth": [
        "login"
      ],
      "success": {
        "status": 200
      }
    }
  ],
  "internal_channel": {
    "between": [
      "server.py",
      "trivia-manager.py"
    ],
    "address": "TCP port 5555",
    "auth_key": "trivia",
    "rpcs": [
      "register_user",
      "get_user_by_credentials",
      "new_trivia_set",
      "get_trivia",
      "verify_answer",
      "get_analytics",
      "get_user",
      "advance_room_question"
    ]
  }
}